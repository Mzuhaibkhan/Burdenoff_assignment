# ─── Database ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/burdenoff

# ─── Authentication ───
JWT_SECRET=change-me-to-a-very-long-and-secure-random-string-at-least-32-chars
JWT_EXPIRY=7d

# ─── Business Hours Configuration ───
BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_HOUR_START=9
BUSINESS_HOUR_END=18

# ─── Server ───
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── Frontend (Vite) ───
VITE_API_URL=http://localhost:4000/graphql
