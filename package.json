{
  "name": "burdenoff",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --filter server dev",
    "dev:web": "bun run --filter web dev",
    "build": "bun run --filter '*' build",
    "gendb": "bunx prisma migrate dev && bunx prisma generate",
    "gendb:reset": "bunx prisma migrate reset --force && bunx prisma generate",
    "seed": "bun run prisma/seed.ts",
    "codegen": "bun run --filter server codegen",
    "codegen:watch": "bun run --filter server codegen:watch",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "lint": "eslint 'apps/**/*.{ts,tsx}' 'packages/**/*.ts'",
    "format": "prettier --write '**/*.{ts,tsx,css,json,graphql}'",
    "format:check": "prettier --check '**/*.{ts,tsx,css,json,graphql}'",
    "typecheck": "tsc --noEmit -p apps/server/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "db:studio": "bunx prisma studio",
    "db:push": "bunx prisma db push",
    "postinstall": "bunx prisma generate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.5.0",
    "@prisma/client": "~6.4.0",
    "prisma": "~6.4.0",
    "@node-rs/argon2": "^2.0.0"
  },
  "dependencies": {
    "@types/bun": "^1.4.0",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
